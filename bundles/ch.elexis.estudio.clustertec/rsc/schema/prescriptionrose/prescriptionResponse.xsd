			<xs:sequence>
				<xs:element ref="interaction" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="errorCode" type="errorCode"/>
			<xs:attribute name="errorMessage" type="xs:string"/>
		</xs:complexType>
	</xs:element>
</xs:schema>
